Include /Users/ilya/.colima/ssh_config

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/github

Host *.lan
    IdentityFile ~/.ssh/default

Host router.lan
    Port 8392

Host extender.lan
    Port 5823

Host *
    IdentityAgent "~/.1password/agent.sock"
    IdentitiesOnly yes
