{
    "breadcrumbs.enabled": false,
    "cSpell.language": "en-US",
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.lineNumbers": "relative",
    "editor.minimap.enabled": false,
    "editor.tabSize": 2,
    "elixirLS.fetchDeps": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.compactFolders": false,
    "gitlens.menus": {
        "editor": false,
        "editorGroup": false,
        "editorTab": false,
        "explorer": false,
        "scmGroup": false,
        "scmItem": false
    },
    "files.associations": {
        "*plays.yml": "ansible",
        "*init.yml": "yaml",
        "*.dat": "csv (pipe)",
        "*.csv": "csv (semicolon)"
    },
    "path-autocomplete.triggerOutsideStrings": true,
    "terminal.integrated.allowChords": false,
    "vim.smartRelativeLine": true,
    "window.title": "${activeEditorLong}${separator}${rootName}",
    "workbench.editor.closeEmptyGroups": false,
    "workbench.editor.labelFormat": "short",
    "workbench.editor.revealIfOpen": true,
    "workbench.editor.showTabs": "multiple",
    "workbench.sideBar.location": "left",
    "workbench.statusBar.visible": true,
    "workbench.colorTheme": "One Dark Pro Darker",
    "workbench.iconTheme": "material-icon-theme",
    "zenMode.fullScreen": false,
    "zenMode.hideLineNumbers": false,
    "errorLens.enabled": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
        "source.fixAll.shellcheck": "explicit"
    },
    "shellcheck.enable": true,
    "shellcheck.enableQuickFix": true,
    "shellcheck.run": "onType",
    "shellcheck.executablePath": "",
    "shellcheck.exclude": [],
    "shellcheck.customArgs": [],
    "shellcheck.ignorePatterns": {
      "**/*.csh": true,
      "**/*.cshrc": true,
      "**/*.fish": true,
      "**/*.login": true,
      "**/*.logout": true,
      "**/*.tcsh": true,
      "**/*.tcshrc": true,
      "**/*.xonshrc": true,
      "**/*.xsh": true,
      "**/*.zsh": true,
      "**/*.zshrc": true,
      "**/zshrc": true,
      "**/*.zprofile": true,
      "**/zprofile": true,
      "**/*.zlogin": true,
      "**/zlogin": true,
      "**/*.zlogout": true,
      "**/zlogout": true,
      "**/*.zshenv": true,
      "**/zshenv": true,
      "**/*.zsh-theme": true
    },
    "shellcheck.ignoreFileSchemes": ["git", "gitfs", "output"],
    "ctags-companion.command": "ctags -R --fields=+nKz --langmap=SystemVerilog:+.v -R rtl /opt/uvm-1.2/src",
    "git.autofetch": true,
    "oneDarkPro.vivid": true,
    "oneDarkPro.italic": true,
    "editor.fontFamily": "Menlo, Monaco, 'Cascadia Code', 'Fira Code', 'IBM Plex Mono', monospace",
    "editor.fontLigatures": "'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'zero', 'onum'",
    "editor.fontWeight": "normal",
    "editor.fontSize": 12
}
