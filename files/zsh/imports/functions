#!/bin/bash

# Delete a given line number in the known_hosts file
function knownrm() {
 re='^[0-9]+$'
 if ! [[ $1 =~ $re ]] ; then
   echo "error: line number missing" >&2;
 else
   sed -i '' "$1d" ~/.ssh/known_hosts
 fi
}

# Enter a running Docker container
function denter() {
 if [[ ! "$1" ]] ; then
     echo "You must supply a container ID or name."
     return 0
 fi

 docker exec -it "$1" bash
 return 0
}

# Change PHP version
function phpv() {
  local version="$1"

  if [[ -z "$version" ]]; then
    echo "Usage: phpv <version>"
    return 1
  fi

  # Detect the formula name
  local formula_name="php@$version"
  if brew list --formula | grep -q "^php\$"; then
    # Handle versions installed as 'php' (e.g., latest stable version)
    local installed_version
    installed_version=$(brew info php --json | jq -r '.[0].versions.stable' 2>/dev/null | awk -F. '{print $1"."$2}')
    if [[ "$installed_version" == "$version" ]]; then
      formula_name="php"
    fi
  fi

  # Check if the version is installed
  if ! brew list --formula | grep -q "^$formula_name\$"; then
    echo "PHP $version is not installed"
    return 1
  fi

  # Get the current PHP version
  local current_version
  if command -v php &> /dev/null; then
    current_version=$(php -v | head -n 1 | awk '{split($2, ver, "."); print ver[1]"."ver[2]}')
  else
    current_version=""
  fi

  if [[ "$version" == "$current_version" ]]; then
    echo "PHP version is already switched to $current_version"
    return 0
  fi

  # Unlink the current PHP version
  echo "Unlinking PHP $current_version..."
  if [[ -n "$current_version" ]]; then
    brew unlink php@"$current_version" &> /dev/null || brew unlink php &> /dev/null || echo "Unable to unlink PHP $current_version"
  fi

  # Link the requested PHP version
  echo "Linking PHP $version..."
  if ! brew link --overwrite --force "$formula_name" &> /dev/null; then
    echo "Unable to link PHP $version"
    return 1
  fi

  # Refresh shell environment
  hash -r

  # Confirm the new PHP version
  if command -v php &> /dev/null; then
    local switched_version
    switched_version=$(php -v | head -n 1 | awk '{print $2}')
    echo "PHP version changed to $switched_version"
    php -v
  else
    echo "PHP command is not available after switching to $version"
    return 1
  fi
}

tf() {
    local path="$1"
    local extension="$2"

    # Validate input parameters
    if [[ -z "$path" || -z "$extension" ]]; then
        echo "Usage: truncate_files <path> <extension>"
        return 1
    fi

    # Ensure 'find' and 'truncate' exist in the system
    if ! command -v /usr/bin/find &>/dev/null; then
        echo "Error: 'find' command not found."
        return 1
    fi

    if ! command -v /usr/bin/truncate &>/dev/null; then
        echo "Error: 'truncate' command not found."
        return 1
    fi

    # Run the command using absolute paths to avoid environment issues
    /usr/bin/find "$path" -type f -name "*.$extension" -exec /usr/bin/truncate -s 0 {} +

    echo "All *.$extension files in $path have been truncated."
}
