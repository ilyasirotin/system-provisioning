[user]
  name = Ilya Sirotin
  email = ilyasirotin.we@gmail.com
[init]
  defaultBranch = master
[core]
  editor = vim
  excludesfile = ~/.gitignore
  autocrlf = input
  whitespace=cr-at-eol
[color]
  branch = auto
  diff = auto
  interactive = auto
  status = auto
  ui = auto
[credential]
  helper = osxkeychain
[push]
  default = current
[pull]
  rebase = false
[alias]
  s = status
  bl = branch -l
  c = commit
  ca = commit -a
  cm = commit -m
  cam = commit -am
  d = diff
  dc = diff --cached
  l = "log --graph --pretty=format:\"%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset\" --abbrev-commit"
